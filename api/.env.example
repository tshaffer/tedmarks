# Copy to api/.env and fill in. Never commit api/.env.
PORT=4100

# Same Atlas cluster as Tedography; Tedmarks uses its own database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0-xxxxx.mongodb.net
MONGODB_DB=tedmarks

# Sign in with Apple
APPLE_BUNDLE_ID=com.example.tedmarks
# Comma-separated Apple user ids ("sub") allowed to sign in
ALLOWED_APPLE_USER_IDS=
SESSION_SECRET=

# Google Places (API key restricted to places.googleapis.com)
GOOGLE_PLACES_API_KEY=

# Claude
ANTHROPIC_API_KEY=
