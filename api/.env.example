# Copy to api/.env and fill in. Never commit api/.env.
PORT=4200

# Same Atlas cluster as Tedography; Tedmarks uses its own database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0-xxxxx.mongodb.net
MONGODB_DB=tedmarks

# Interim protection until Sign in with Apple: the app sends this in X-Tedmarks-Key.
# Leave unset for local dev without a key. Generate with: openssl rand -hex 32
API_ACCESS_KEY=

# Sign in with Apple
APPLE_BUNDLE_ID=com.example.tedmarks
# Comma-separated Apple user ids ("sub") allowed to sign in
ALLOWED_APPLE_USER_IDS=
SESSION_SECRET=

# Google Places (API key restricted to places.googleapis.com)
GOOGLE_PLACES_API_KEY=

# Start visit nearby search radius default (meters). The app's Settings override it.
# NEARBY_RADIUS_METERS=1609

# Claude
ANTHROPIC_API_KEY=
