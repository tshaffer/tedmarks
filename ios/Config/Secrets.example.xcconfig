// Copy to Secrets.xcconfig (git-ignored) and fill in.
// In xcconfig files "//" starts a comment, so URLs use $() to break it up.

// Cloud API, or the dev server on the Mac: http:/$()/Teds-MacBook-Pro.local:4200
TEDMARKS_API_BASE_URL = https:/$()/your-app.herokuapp.com

// Must match API_ACCESS_KEY on the server.
TEDMARKS_API_KEY =

// Google Maps SDK for iOS (Start a visit's map). An API key restricted to iOS apps with the
// bundle ID com.tedshaffer.tedmarks, and to the Maps SDK for iOS. Empty = the list instead.
TEDMARKS_GOOGLE_MAPS_KEY =

// Map ID (map type iOS) with the same map style as the website's Map ID, so the map shows the
// same things (restaurants only). Empty = Google's default map.
TEDMARKS_GOOGLE_MAP_ID =
