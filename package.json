{
  "name": "tedmarks",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @tedmarks/api dev",
    "indexes:create": "pnpm --filter @tedmarks/api indexes:create",
    "openapi:generate": "pnpm --filter @tedmarks/shared openapi:generate",
    "start": "node api/dist/index.js",
    "dev:web": "pnpm --filter @tedmarks/web dev"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
